{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiplexr.app/schemas/v1/protocol-1.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
        },
        "params": {}
      },
      "required": [
        "v",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "result": {}
      },
      "required": [
        "v",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "invalid_response",
                "version_mismatch",
                "unsupported_capability",
                "permission_denied",
                "not_found",
                "conflict",
                "cancelled",
                "deadline_exceeded",
                "resource_limit",
                "message_too_large",
                "busy",
                "plugin_error",
                "runtime_failure"
              ]
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
